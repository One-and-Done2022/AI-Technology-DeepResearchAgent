# Copy this file to .env.local and fill only the backend you use.
# Never commit .env.local.

# LLM backend used by configs/default.yaml
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional local backend used by configs/smoke.yaml
# VLLM_API_KEY=EMPTY
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Web search: bocha | serpapi | bing | metaso
SEARCH_BACKEND=bocha
BOCHA_API_KEY=replace_me
BOCHA_API_ENDPOINT=https://api.bochaai.com/v1/web-search
# SERPAPI_KEY=replace_me
# BING_SEARCH_KEY=replace_me
# METASO_API_KEY=replace_me

# Academic search: openalex works without a key.
ARXIV_READER_BACKEND=openalex
# OPENALEX_EMAIL=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=replace_me

# Optional GitHub token raises the public API rate limit.
# GITHUB_TOKEN=replace_me

# Optional browser settings.
BROWSER_TIMEOUT=15
# BROWSER_USER_AGENT=Mozilla/5.0 ...

# Optional tracing.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace_me
# LANGSMITH_PROJECT=ai-technology-research-agent
